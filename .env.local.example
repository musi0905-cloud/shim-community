# Supabase 프로젝트 설정 → API 에서 확인한다.
# 이 파일은 예시다. 실제 값은 .env.local 에 넣고 절대 commit 하지 않는다.

# 브라우저에 노출되어도 되는 값 (RLS 가 실제 접근을 통제한다)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 매직 링크가 돌아올 사이트 주소. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────
# service_role key 는 Sprint 1 에서 사용하지 않는다.
# 이 키는 RLS 를 전부 우회하므로 브라우저로 나가면 DB 전체가 노출된다.
# 필요해지더라도 NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다.
# SUPABASE_SERVICE_ROLE_KEY=
